# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration — à copier en `.env` puis à remplir avec tes valeurs.
#   cp .env.example .env
# Le fichier `.env` est ignoré par git : il ne doit JAMAIS être poussé sur GitHub.
# docker-compose lit automatiquement `.env` à la racine du projet.
# Les variables marquées (obligatoire) empêchent le démarrage si elles sont vides.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alertes ──────────────────────────────────────────────────────────────────
# Webhook Discord pour les alertes de fraude, d'échec, de monitoring et de sécurité.
# Discord → Paramètres du canal → Intégrations → Webhooks → Copier l'URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYYYY

# ── Airflow ──────────────────────────────────────────────────────────────────
# UID de l'utilisateur Airflow dans les conteneurs (Linux/WSL : `id -u`).
# Sur Windows / macOS, laisser 50000.
AIRFLOW_UID=50000

# Compte administrateur de l'interface web Airflow (http://localhost:8080).
# Changer le mot de passe par défaut avant toute exposition.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-moi

# (obligatoire) Clé de chiffrement des connexions et Variables Airflow. À générer UNE fois :
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# La changer rend illisibles les secrets déjà chiffrés (voir README § Rotation de la clé).
AIRFLOW__CORE__FERNET_KEY=

# (obligatoire) Clé de signature des sessions de l'interface web. Chaîne aléatoire longue :
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# ── Base métier fraud-db ─────────────────────────────────────────────────────
FRAUD_DB_USER=fraud
# (obligatoire) Uniquement lettres et chiffres : le mot de passe est inséré dans une URL.
FRAUD_DB_PASSWORD=
FRAUD_DB_NAME=fraud

# ── Grafana (tableau de bord de monitoring, http://localhost:3000) ───────────
GRAFANA_ADMIN_USER=admin
# (obligatoire)
GRAFANA_ADMIN_PASSWORD=
# (obligatoire) Mot de passe du rôle PostgreSQL en lecture seule utilisé par Grafana.
GRAFANA_DB_PASSWORD=

# ── Ports publiés sur l'hôte (127.0.0.1 uniquement) ──────────────────────────
# À modifier seulement en cas de conflit avec un autre service local.
AIRFLOW_WEB_PORT=8080
FRAUD_DB_PORT=5433
GRAFANA_PORT=3000
